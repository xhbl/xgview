<?xml version="1.0" encoding="utf-8"?>
<!--
  XGView Android manifest sample.

  This file is a reference for the cargo-ndk build pipeline (see
  scripts/build-android.sh). It is *not* consumed by cargo itself: the Android
  Gradle project generated around the `monitor_android` cdylib is expected to
  copy this manifest into `app/src/main/AndroidManifest.xml`.

  Design notes:
    * The activity is a `NativeActivity`, so the whole UI (egui + wgpu) runs
      inside the native library produced by `monitor_android`.
    * It is a subclass - `MainActivity` - rather than the platform class, so
      that the system bars can be hidden from Java: a window that only fills
      the screen still has the navigation bar drawn over it, and on a phone in
      landscape that bar lies along the right edge, over the toolbar.
    * `android.app.lib_name` must match the `[lib] name` of the crate, which is
      `monitor_android`.
    * The launcher icon comes from the `mipmap-*` densities beside this file:
      the legacy bitmaps (`ic_launcher`, `ic_launcher_round`) and the adaptive
      pair (`mipmap-anydpi-v26` over the foreground bitmaps). The TV launcher
      additionally draws the `drawable-xhdpi/ic_launcher_banner.png`. All of
      them are placeholders until real artwork replaces them; see
      `scripts/make-icons.py`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access is required to pull RTSP streams and to run ONVIF / TCP
         port discovery. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Start on boot: the receiver below relaunches XGView after the device
         finished booting. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 10+ refuses a background activity start, and a BOOT_COMPLETED
         receiver is a background start: without being whitelisted the
         relaunch below is aborted by the system ("Abort background activity
         starts"), silently as far as the viewer is concerned. Holding
         SYSTEM_ALERT_WINDOW is one of the accepted whitelist conditions, so it
         is declared here. It is a special permission: the user grants it once
         under Settings - Apps - Special access - Display over other apps (or
         `adb shell appops set com.xhbl.xgview SYSTEM_ALERT_WINDOW allow`), and
         the app itself never draws an overlay. Making XGView the device's
         launcher is the alternative that needs no permission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keep the screen on while the surveillance wall is displayed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Writing the exported configuration into the public Download/xgview
         folder. Android 10 (API 29) lets an app do that through MediaStore with
         no permission at all, and that is the route taken from there on; on
         Android 9 there is no MediaStore route and the write is a plain one
         into the public directory, which needs this permission. The attribute
         is what keeps Android 10+ from asking for a permission it never uses. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Broadcast / multicast reception has to be enabled on some TV boxes,
         otherwise the WS-Discovery probe never leaves the device. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Talk-back captures the viewer's voice. Declared rather than implied:
         without it Oboe refuses to open an input stream at all, and the
         magnified bar's microphone would show and do nothing. The grant is a
         runtime one from Android 6, asked for by `MainActivity.requestRecordAudio`
         the first time the microphone is switched on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android TV / leanback is optional, the app also runs on phones and
         on the plain Android launcher. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Plenty of the boxes this runs on - a television or a Shield - have no
         microphone at all, and the viewer works there: the talk switch is simply
         never offered. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/ic_launcher_banner"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- The transparent entry point. It reads the remembered orientation
             from xgvconfig.json and starts the matching fixed-orientation
             activity below, then finishes. This is what keeps the wall from
             coming up one way and turning to the other: Android fixes the
             window orientation from the manifest at creation time, before any
             code runs, so the only way to start already turned is to have two
             activities - one landscape, one portrait - and pick the right one
             before any native rendering begins. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV entry point so the app shows up on the leanback
                 launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Optional: makes XGView a candidate home app, which is the other
                 way to start on boot and needs no permission at all. It is only
                 a candidate - the viewer picks it under Settings - and nothing
                 changes until they do. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The wall, landscape. `userLandscape` allows both landscape
             directions and follows the device sensor, while still respecting
             the user's rotation lock; portrait is not allowed either way.

             The activity is not recreated when the display turns: `orientation`
             and `screenSize` are in `configChanges` above. That matters because
             the native side owns a winit event loop, and winit refuses to
             create a second one; the insets are re-read instead, which is what
             puts the reserved navigation bar strip back on the right side. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="userLandscape"
            android:windowSoftInputMode="stateAlwaysHidden">

            <!-- Entry point of the native library. Must match `[lib] name`. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="monitor_android" />
        </activity>

        <!-- The wall, portrait. The same MainActivity class with a
             portrait-fixed orientation, so the window comes up already
             turned. Launched by LauncherActivity when the remembered
             orientation is portrait. -->
        <activity
            android:name=".MainActivityPortrait"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="userPortrait"
            android:windowSoftInputMode="stateAlwaysHidden">

            <meta-data
                android:name="android.app.lib_name"
                android:value="monitor_android" />
        </activity>

        <!-- Relaunches the activity after the device booted. See
             java/com/xhbl/xgview/BootReceiver.java. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
