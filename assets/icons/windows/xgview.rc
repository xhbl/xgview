// Windows resources for `xgview.exe`.
//
// This file is a template. `build.rs` fills in every `@...@` placeholder before
// compiling it, taking the value from Cargo.toml, so the version block can
// never drift from the release: bump `[workspace.package] version` and rebuild.
// The strings written out literally have no Cargo.toml equivalent and are
// edited here instead.
//
// The lowest-numbered icon resource is the one Windows shows in Explorer, on
// the taskbar and in the Alt-Tab switcher, so the icon carries `1`. None of
// this is compiled off Windows: on Linux and macOS the artwork travels as a PNG
// or an `.icns` beside the bundle instead (see `assets/icons/`).
//
// `build.rs` writes the filled-in copy next to a copy of the icon it names, so
// the bare `xgview.ico` below resolves within the build directory.
#pragma code_page(65001)

1 ICON "xgview.ico"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS @FILEFLAGS@
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0x0409 English (United States), 0x04b0 Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@COMPANY_NAME@"
            VALUE "FileDescription", "@FILE_DESCRIPTION@"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "@INTERNAL_NAME@"
            VALUE "LegalCopyright", "@LEGAL_COPYRIGHT@"
            VALUE "OriginalFilename", "@ORIGINAL_FILENAME@"
            // Matches `monitor_core::APP_DISPLAY_NAME`; a build script cannot
            // import the crate it builds, so the name is repeated once, here.
            VALUE "ProductName", "XGView"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END